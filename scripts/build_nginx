#!/bin/bash
# Build NGINX and modules for Heroku.
# This script is designed to run in a Heroku Stack Docker
# image. More information on the Heroku Stack can be found
# at https://devcenter.heroku.com/articles/stack

# fail hard
set -o pipefail
# fail harder
set -eu

# The NGINX OTel module uses gRPC with the system c-ares package. libarchive
# (bsdtar) sidesteps a GNU tar 1.35 bug that corrupts extraction under
# Rosetta-emulated amd64 on Apple Silicon build hosts.
apt-get update
apt-get install --no-install-recommends -y cmake pkg-config libc-ares-dev libarchive-tools
rm -rf /var/lib/apt/lists/*

NGINX_VERSION=${NGINX_VERSION-1.30.2}
HEADERS_MORE_VERSION=${HEADERS_MORE_VERSION-0.39}
UUID4_VERSION=${UUID4_VERSION-f8f7ff44e6a8c6cf75232ae4b63d011f2f3b34c1}
# v0.1.2 (latest tagged release) pins OTel C++ SDK v1.11.0, whose
# cmake_minimum_required() predates CMake 3.5 -- CMake 4.x (as apt-installs
# on heroku-26) refuses to configure it ("Compatibility with CMake < 3.5 has
# been removed from CMake"). Pin a main-branch commit that bumped the SDK to
# v1.23.0 and builds cleanly instead of the stale tag.
OTEL_VERSION=${OTEL_VERSION-e3b6c98b1556e4c82cec39acc7be91a62449fa84}
OTEL_BUILD_JOBS=${OTEL_BUILD_JOBS-2}

nginx_tarball_url=https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz
headers_more_nginx_module_url=https://github.com/openresty/headers-more-nginx-module/archive/v${HEADERS_MORE_VERSION}.tar.gz
uuid4_url=https://github.com/cybozu/nginx-uuid4-module/archive/${UUID4_VERSION}.tar.gz
otel_module_url=https://github.com/nginx/nginx-otel/archive/${OTEL_VERSION}.tar.gz

temp_dir=$(mktemp -d /tmp/nginx.XXXXXXXXXX)

trap popd EXIT
pushd "$temp_dir"

echo "Downloading $nginx_tarball_url"
curl -sSL "$nginx_tarball_url" -o nginx.tar.gz
bsdtar xzf nginx.tar.gz

echo "Downloading $headers_more_nginx_module_url"
curl -sSL "$headers_more_nginx_module_url" -o headers-more.tar.gz
bsdtar xzf headers-more.tar.gz -C "nginx-${NGINX_VERSION}"

echo "Downloading $uuid4_url"
curl -sSL "$uuid4_url" -o uuid4.tar.gz
bsdtar xzf uuid4.tar.gz -C "nginx-${NGINX_VERSION}"

echo "Downloading $otel_module_url"
curl -sSL "$otel_module_url" -o otel.tar.gz
bsdtar xzf otel.tar.gz

otel_module_dir="${temp_dir}/nginx-otel-${OTEL_VERSION}"
otel_build_dir="${temp_dir}/nginx-otel-build"

configure_opts=(
  --with-pcre
  --with-http_gzip_static_module
  --with-http_realip_module
  --with-http_ssl_module
  --with-http_stub_status_module
  --with-compat
  --add-module="${temp_dir}/nginx-${NGINX_VERSION}/headers-more-nginx-module-${HEADERS_MORE_VERSION}"
  --add-module="${temp_dir}/nginx-${NGINX_VERSION}/nginx-uuid4-module-${UUID4_VERSION}"
)
if [[ $STACK == "heroku-22" ]]; then
  # we used to build our own PCRE 8.x, and when moving to dynamic linking, we had to ensure all existing regexes in config files continued to work, so we enforced libpcre3 (8.x) usage instead of the newer PCRE2 (10.x), which has stricter validation for certain patterns (example: /[\w-.]/ is not allowed in PCRE2)
  # but for any newer stacks, we can use the more modern PCRE2
  configure_opts+=(
    --without-pcre2
  )
fi

# Configure once without installing so the OTel module can use the generated
# NGINX build metadata. The module must be built against the exact NGINX
# source and configuration used for the binary.
(
  cd "nginx-${NGINX_VERSION}"
  ./configure \
    --prefix=/tmp/nginx \
    "${configure_opts[@]}"
)

cmake -S "$otel_module_dir" -B "$otel_build_dir" \
  -DNGX_OTEL_NGINX_BUILD_DIR="${temp_dir}/nginx-${NGINX_VERSION}/objs"
cmake --build "$otel_build_dir" --parallel "$OTEL_BUILD_JOBS"

# This will build `nginx`
(
  cd "nginx-${NGINX_VERSION}"
  make install
  # strip binary (but not the nginx-debug variant further down)
  find /tmp/nginx -type f \( -executable -o -name '*.a' \) -exec sh -c "file -i '{}' | grep -Eq 'application/x-(archive|(pie-)?executable|sharedlib); charset=binary'" \; -print | xargs strip --strip-unneeded
)

# This will build `nginx-debug`
(
  cd "nginx-${NGINX_VERSION}"
  ./configure \
    --with-debug \
    --prefix=/tmp/nginx-debug \
    "${configure_opts[@]}"
  make install
)

release_dir=$(mktemp -d /tmp/nginx.XXXXXXXXXX)

mv /tmp/nginx/sbin/nginx "$release_dir/nginx"
mv /tmp/nginx-debug/sbin/nginx "$release_dir/nginx-debug"
mv /tmp/nginx/conf/mime.types "$release_dir/mime.types"
mkdir -p "$release_dir/modules"
cp "$otel_build_dir/ngx_otel_module.so" "$release_dir/modules/"
tar -zcvf "$1" -C "$release_dir" .
